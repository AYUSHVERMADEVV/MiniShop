{
  "name": "minishop-root",
  "version": "1.0.0",
  "description": "MiniShop - MERN Stack Inventory Management Dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node server/src/index.js",
    "build": "npm run build --workspace=client",
    "start": "node server/src/index.js",
    "server": "npm run dev --workspace=server",
    "client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "test:server": "npm run test --workspace=server",
    "install:all": "npm install",
    "lint": "node --check server/src/index.js server/src/config/db.js server/src/models/Product.js server/src/controllers/productController.js",
    "test": "npm run test --workspace=server"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "vite": "^6.0.7"
  }
}
