# MiniShop Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
# Example:
# MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.xyz.mongodb.net/minishop?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/minishop?retryWrites=true&w=majority
